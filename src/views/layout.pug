doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Cimientos Sólidos S.A.
    link(rel="icon", type="image/png", href="/favicon.png")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    style.
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
  body.bg-light 
    header
      nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm 
        div.container
          a.navbar-brand.fw-bold(href='/') Cimientos Sólidos
          button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav", aria-controls="navbarNav", aria-expanded="false", aria-label="Toggle navigation")
            span.navbar-toggler-icon

          div#navbarNav.collapse.navbar-collapse
            ul.navbar-nav.me-auto
              li.nav-item 
                a.nav-link(href="/") Inicio
              if usuario 
                li.nav-item 
                  a.nav-link(href="/obras/vista") Obras 
                li.nav-item 
                  a.nav-link(href="/gastos/vista") Gastos

                if usuario.rol === 'Administrador'
                  li.nav-item.dropdown 
                    a.nav-link.dropdown-toggle.text-warning(href="#", id="navbarDropdown", role="button", data-bs-toggle="dropdown") Configuración Personal
                    ul.dropdown-menu.dropdown-menu-end(aria-labelledby="navbarDropdown")
                      li 
                        a.dropdown-item(href="/usuarios/vista") Lista de Usuarios 
                      li 
                        a.dropdown-item(href="/auth/registro") Registrar Usuario 

            if usuario 
              div.d-flex.align-items-center
                span.navbar-text.me-3.text-white.small Hola, #{usuario.nombre}
                  span.badge.bg-secondary.ms-1 #{usuario.rol}
                a.btn.btn-outline-danger.btn-sm(href="/auth/logout") Cerrar Sesión

    main.container.my-5
      block content 

    footer.bg-dark.text-white.text-center.py-3.mt-auto 
      div.container
        p.mb-0.small &copy; #{new Date().getFullYear()} Cimientos Sólidos S.A. - Panel de Gestión Avanzado Backend - TechArg

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")