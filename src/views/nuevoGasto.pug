extends layout

block content
  h2 Nuevo Gasto

  form(method="POST", action="/gastos")

    label Obra: 
    select(name="obraId" required)
      option(value="") Seleccionar obra

      each obraItem in obras
        if obraId && obraItem.id == obraId
          option(value=obraItem.id selected) #{obraItem.nombre}
        else
          option(value=obraItem.id) #{obraItem.nombre}

    br
    br

    label Concepto: 
    input(type="text", name="concepto")

    br
    br

    label Monto: 
    input(type="number", name="monto" required)

    br
    br

    label Fecha: 
    input(type="date", name="fecha" required)

    br
    br

    label Medio de pago: 
    select(name="medioPago")
      option(value="Cheque") Cheque
      option(value="Transferencia") Transferencia

    br
    br

    button(type="submit") Guardar Gasto