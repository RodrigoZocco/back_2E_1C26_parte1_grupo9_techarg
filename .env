# SUBIMOS EL .ENV porque no tiene datos sensitivos
# NUNCA deberiamos agregar este archivo, pero hacemos la excepcion para esta primer entrega
# Si agregamos datos sensitivos, ocultaremos el .env 
# y cargaremos el .env.dist (solo con las keys de nuestras variables y values que no sean sensibles)
PORT = 3000

# Iteracion actual (mongo atlas corriendo en produccion - cluster gratuito tal cual lo vimos en clase)
MONGODB_URI = mongodb+srv://<mongoDBUsername>:<mongoDBPassword>@cluster0.x0sdkas.mongodb.net/?appName=Cluster0
# ITERACION ANTERIOR (Con MongoDB corriendo localmente)
# MONGODB_URI = mongodb://127.0.0.1:27017/cimientos_solidos
