doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión - Cimientos Sólidos
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
  body.bg-dark.d-flex.align-items-center.justify-content-center(style="min-height: 100vh;")
    
    div.card.shadow-lg.p-4.bg-white.rounded(style="width: 100%; max-width: 400px;")
      div.text-center.mb-4
        h2.fw-bold.text-primary 🏗️ Cimientos Sólidos
        p.text-muted.small Sistema de Gestión Interna

      //- Muestra una alerta si el controlador devuelve un mensaje de error
      if error
        div.alert.alert-danger.py-2.small.text-center #{error}

      form(action="/auth/login" method="POST")
        div.mb-3
          label.form-label.small.fw-bold(for="email") Correo Electrónico
          input.form-control(type="email" id="email" name="email" required placeholder="ejemplo@techarg.com")
        
        div.mb-3
          label.form-label.small.fw-bold(for="password") Contraseña
          input.form-control(type="password" id="password" name="password" required placeholder="••••••••")
        
        div.d-grid.gap-2.mt-4
          button.btn.btn-primary(type="submit") Ingresar al Sistema
          
      div.text-center.mt-4
        span.text-muted.style(style="font-size: 0.75rem;") TechArg &copy; #{new Date().getFullYear()}