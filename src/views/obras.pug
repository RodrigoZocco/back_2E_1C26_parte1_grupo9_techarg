extends layout

block content
  div.d-flex.justify-content-between.align-items-center.mb-4 
    div 
      h2.fw-bold.text-dark Proyectos y Obras Activas
      p.text-muted.small Seguimiento de presupuestos base y locaciones en ejecución.
    div 
      a.btn.btn-success.fw-bold(href="/obras/nuevo") + Nueva Obra

  div.card.shadow-sm.border 
    div.card-body.p-0 
      table.table.table-hover.align-middle.mb-0 
        thead.table-dark 
          tr 
            th(scope="col") Nombre del Proyecto 
            th(scope="col") Ubicación 
            th(scope="col") Director Asignado 
            th(scope="col") Presupuesto Base 
            th(scope="col" class="text-center") Operaciones
        tbody 
          if obras.length === 0
            tr 
              td.text-center.py-4.text-muted(colspan="5") No hay obras registradas actualmente en el sistema.
          else 
            each obra in obras 
              tr 
                td 
                  span.fw-bold.text-primary #{obra.nombre} 
                td 
                  i.text-muted #{obra.ubicacion} 
                td 
                  span.badge.bg-light.text-dark.border #{obra.director} 
                td 
                  span.fw-bold.text-success $ #{obra.presupuestoTotal.toLocaleString('es-AR')} 
                td.text-center 
                  a.btn.btn-outline-primary.btn-sm.fw-bold(href=`/obras/${obra._id || obra.id}/vista`) Ver Ficha 
